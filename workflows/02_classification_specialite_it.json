{
  "name": "LBA – Classification spécialité IT",
  "nodes": [
    { "id": "560f5dca-06a3-4e13-a72b-c8097ce13c27", "name": "Lancer", "type": "n8n-nodes-base.manualTrigger", "typeVersion": 1, "position": [0, 0], "parameters": {} },
    {
      "id": "89852674-e378-4859-a650-099ca25cc94f",
      "name": "Entreprises simplifiées non classées",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [224, 0],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": { "__rl": true, "mode": "list", "value": "ID_TABLE_LBA_ENTREPRISES", "cachedResultName": "lba_entreprises" },
        "matchType": "allConditions",
        "filters": { "conditions": [ { "condition": "isTrue", "keyName": "candidature_simplifiee" }, { "condition": "isEmpty", "keyName": "classifie_par" } ] },
        "returnAll": true
      }
    },
    {
      "id": "d864053a-2b66-4b6b-bfb9-fa318479e5f3",
      "name": "Filtre informatique",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [448, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "combinator": "or",
          "conditions": [
            { "id": "c1", "leftValue": "={{ $json.code_rome }}", "operator": { "type": "string", "operation": "startsWith" }, "rightValue": "M18" },
            { "id": "c2", "leftValue": "={{ $json.code_rome }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "I1401" },
            { "id": "c3", "leftValue": "={{ $json.secteur_naf }}", "operator": { "type": "string", "operation": "contains" }, "rightValue": "informatique" },
            { "id": "c4", "leftValue": "={{ $json.secteur_naf }}", "operator": { "type": "string", "operation": "contains" }, "rightValue": "logiciel" },
            { "id": "c5", "leftValue": "={{ $json.secteur_naf }}", "operator": { "type": "string", "operation": "contains" }, "rightValue": "Traitement de données" }
          ]
        },
        "options": { "ignoreCase": true }
      }
    },
    { "id": "0349f335-469d-4df0-beac-8ae7ee50c89f", "name": "Limite du lot", "type": "n8n-nodes-base.limit", "typeVersion": 1, "position": [672, 0], "parameters": { "maxItems": 150 } },
    {
      "id": "6824e6a2-b53b-4e20-940b-819f72396d9f",
      "name": "Recherche web",
      "type": "@tavily/n8n-nodes-tavily.tavily",
      "typeVersion": 1,
      "position": [896, 0],
      "parameters": {
        "resource": "search",
        "operation": "query",
        "query": "=\"{{ $json.nom }}\" {{ $json.adresse.split(' ').slice(-1)[0] }}",
        "options": {
          "search_depth": "basic",
          "max_results": 5,
          "include_answer": "basic",
          "country": "france",
          "exclude_domains": [
            "societe.com", "pappers.fr", "annuaire-entreprises.data.gouv.fr", "entreprises.lagazettefrance.fr",
            "entreprises.lefigaro.fr", "societeinfo.com", "pple.fr", "mappy.com", "pagesjaunes.fr", "e-pro.fr",
            "infogreffe.fr", "verif.com", "manageo.fr", "linkedin.com", "indeed.com", "labonnealternance.apprentissage.beta.gouv.fr"
          ]
        }
      },
      "credentials": { "tavilyApi": { "id": "REPLACE_ME", "name": "Tavily account" } }
    },
    {
      "id": "b7e3cda3-2caf-413c-b280-fb7975908ec6",
      "name": "Préparer l'état",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1120, 0],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "id": "e1", "name": "siret", "type": "string", "value": "={{ $('Limite du lot').item.json.siret }}" },
            { "id": "e2", "name": "resume_web", "type": "string", "value": "={{ $json.answer || '' }}" },
            { "id": "e3", "name": "contexte_web", "type": "string", "value": "={{ ($json.results || []).map(r => r.url + ' | ' + r.title + ' : ' + (r.content || '').slice(0, 300)).join('\\n').slice(0, 2000) }}" },
            { "id": "e4", "name": "etat", "type": "string", "value": "=Entreprise : {{ $('Limite du lot').item.json.nom }}\nAdresse : {{ $('Limite du lot').item.json.adresse }}\nCode NAF : {{ $('Limite du lot').item.json.secteur_naf }}\nTaille : {{ $('Limite du lot').item.json.taille }} salariés\n\nRésumé de recherche web : {{ $json.answer || '' }}\n\nRésultats web :\n{{ ($json.results || []).map(r => '- ' + r.url + ' | ' + r.title + ' : ' + (r.content || '').slice(0, 400)).join('\\n') }}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "c6e4eada-4697-40ae-9915-f3e2ed1e11d9",
      "name": "Jev – spécialité",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [1344, 0],
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/systemone",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openRouterApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'jev-1.13',\n  state: $json.etat,\n  questions: {\n    specialite: {\n      type: 'choice',\n      instructions: \"Quelle est l'activité informatique principale de cette entreprise ?\",\n      criteria: {\n        developpement: 'Éditeur de logiciel, agence web ou mobile, développement sur mesure, SaaS',\n        reseau_infra_support: 'Infogérance, réseaux, systèmes, maintenance informatique, support utilisateurs, hébergement, télécoms, vente de matériel informatique',\n        cybersecurite: 'Sécurité des systèmes d\\'information, audit, pentest, SOC',\n        data_ia: 'Data, BI, intelligence artificielle, traitement de données',\n        erp_conseil: 'Intégration ERP/CRM, conseil en systèmes d\\'information, AMOA',\n        esn_generaliste: 'ESN multi-activités sans dominante claire (infogérance, développement, conseil…)',\n        non_it: \"L'informatique n'est pas le cœur de métier (commerce, industrie, services…)\"\n      }\n    },\n    meme_entreprise: {\n      type: 'noul',\n      instructions: \"Les résultats de recherche web décrivent-ils bien cette entreprise précise (même nom et même localisation), et non une homonyme ?\"\n    }\n  }\n}) }}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput",
      "credentials": { "openRouterApi": { "id": "REPLACE_ME", "name": "OpenRouter account" } }
    },
    {
      "id": "7c5fc318-52d3-4490-bb79-2347b498e7eb",
      "name": "Réponse valide ?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [1456, 0],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [ { "id": "v1", "leftValue": "={{ $json.answers?.specialite?.choice }}", "operator": { "operation": "notEmpty", "singleValue": true, "type": "string" }, "rightValue": "" } ],
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 }
        },
        "options": {}
      }
    },
    {
      "id": "ae6f8d6a-2d9e-429d-8361-c65ac63c8179",
      "name": "Résultat classification",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
