            { "id": "r2", "name": "specialite", "type": "string", "value": "={{ $json.answers.meme_entreprise.noul >= 0.5 ? $json.answers.specialite.choice : 'inconnu' }}" },
            { "id": "r3", "name": "specialite_confiance", "type": "number", "value": "={{ $json.answers.specialite.confidence }}" },
            { "id": "r4", "name": "resume_activite", "type": "string", "value": "={{ $('Préparer l\\'état').item.json.resume_web }}" },
            { "id": "r5", "name": "contexte_web", "type": "string", "value": "={{ $('Préparer l\\'état').item.json.contexte_web }}" },
            { "id": "r6", "name": "classifie_par", "type": "string", "value": "={{ $json.model }}" }
          ]
        },
        "options": {}
      }
    },
